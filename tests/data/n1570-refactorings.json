        "PrimitiveOrNonTypeSpecifier"
      ],
      "constraint": "6.7.2p2",
      "condition": "At least one type; one unique type and no primitive type, or one-or-more primitive types and no unique type. Full primitive multiset constraints remain external."
    },
    {
      "standard": "specifier-qualifier-list",
      "root": "SpecifierQualifiers",
      "unique": "UniqueTypeSpecifier",
      "primitive": "PrimitiveTypeSpecifier",
      "non_type": "TypeQualifier",
      "tail": "PrimitiveOrQualifier",
      "native_categories": [
        "SpecifierQualifiers",
        "PrimitiveOrQualifier"
      ],
      "constraint": "6.7.2p2",
      "condition": "Same partial type condition with qualifiers as the only non-type specifier class."
    }
  ],
  "unique_standard_type_alternatives": [
    "void",
    "_Bool",
    "atomic-type-specifier",
    "struct-or-union-specifier",
    "enum-specifier",
    "typedef-name"
  ],
  "phase6_string_lists": {
    "clause": "6.4.5p5",
    "condition": "A grammar use of the final string-literal token corresponds to a nonempty ordered list of raw token spellings; prefix compatibility and execution encoding are external."
  },
  "byte_carrier_profile": {
    "literal_excluded_bytes": [
      0,
      10,
      13
    ],
    "identifier_encoding": "UTF-8 and UCNs; both use Annex D.1, minus D.2 initially.",
    "literal_ucn_scalar_ranges": [
      [
        36,
        36
      ],
      [
        64,
        64
      ],
      [
        96,
        96
      ],
      [
        160,
        55295
      ],
      [
        57344,
        1114111
      ]
    ],
    "constraints": [
      "6.4.2.1p3",
      "6.4.3p2",
      "Annex D.1",
      "Annex D.2"
    ],
    "condition": "Preprocessed byte carrier; physical LF/CR/NUL are not ordinary literal payload bytes. Native codec escaping is checked separately."
  },
  "cpp_number_guard": {
    "clause": "6.4p4 / 6.4.8",
    "condition": "A conservative rejected-token guard: contains the normative pp-number language; valid integer/float rules win equal-length ties; the guard has no successful phrase rule. Broad byte continuation may overapproximate malformed source."
  },
  "claims_excluded": [
    "Native module activation and import/origin adequacy",
    "Native DFA/LR implementation correctness",
    "Scope-hook and conflict-policy correctness",
    "C typing and execution semantics",
    "Byte escaping and compiler correspondence"
  ]
