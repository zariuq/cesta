(cesta native-c/1 compact-c/2
  (unit
    (ownership (check-all))
    (native "/* The frame rule on a record's own storage: a call lends the callee only the\n   bytes it reaches, in its body or through its callees, each read or written,\n   so a live loan on another field does not stand in the way. */\ntypedef struct { int key; int fired[4]; } Explorer;\nstatic void bump_key(Explorer *x) { x->key += 1; }                 /* writes key */\nstatic void bump_twice(Explorer *x) { bump_key(x); bump_key(x); }  /* writes key through bump_key */\nstatic int read_fired(const Explorer *x) { return x->fired[1]; }   /* reads fired[1] */\nstatic void count_down(Explorer *x, int n) { if (n > 0) { x->key += n; count_down(x, n - 1); } }\nint run(Explorer *x) {\n    const int *held = &x->fired[1];   /* a live loan on fired[1] */\n    bump_twice(x);                    /* lends key alone */\n    count_down(x, 3);\n    int *w = &x->key;                 /* a live exclusive loan on key */\n    *w += read_fired(x);              /* lends fired[1] alone, for reading */\n    return *held + x->key;\n}\nint main(void) { Explorer x = {0, {0, 5, 0, 0}}; return run(&x) == 18 ? 0 : 1; }\n")))
