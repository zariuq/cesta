(cesta native-c/1 compact-c/2
  (unit
    (include <stddef.h>)
    (include <stdint.h>)
    (ownership
      (check-all)
      (allocator heap malloc free
        (obligation "Fresh allocation of the requested extent; free consumes the allocation once and accepts null."))
      (view ByteBuffer data len write (owns heap))
      (view ByteView data len read))
    (native "void *malloc(size_t); void free(void *);\n")
    (typedef (struct ByteBuffer (uint8_t (* data)) (size_t len)) ByteBuffer)
    (typedef (struct ByteView ((const uint8_t) (* data)) (size_t len)) ByteView)
    (fn int main (void)
      (var uint8_t (* data) (cast (uint8_t *) (call malloc 8)))
      (if (! data) (block (call free data) (return 0)))
      (var ByteBuffer first (compound ByteBuffer data 8))
      (var ByteBuffer second first)
      (= ([] (. second data) 0) 42)
      (var int answer 0)
      (block
        (var ByteView borrowed (compound ByteView (. second data) (. second len)))
        (= answer ([] (. borrowed data) 0)))
      (call free (. second data))
      (return (?: (== answer 42) 0 1)))))
