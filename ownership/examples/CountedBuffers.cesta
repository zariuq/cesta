(cesta native-c/1 compact-c/2
  (unit
    (include <stddef.h>)
    (ownership
      (check-all)
      (allocator heap (malloc calloc) free (resize realloc)
        (obligation "Fresh allocation of the requested extent, or null; realloc moves an allocation to fresh storage of the requested extent and releases the old, or returns null and changes nothing; free releases one allocation once and accepts null."))
      (record Table (field cells (owns heap nullable) (count used)))
      (record Window (field cells (borrow read nullable) (count n)))
      (unchecked push (grows 0)
        (obligation "Appends one value, moving the buffer to a larger allocation of the heap family when full; on failure nothing changes."))
      (unchecked main
        (obligation "Owns the table: creates it empty, lends it to the checked functions, then releases its buffer and the table."))
      (function at (returns-borrow 0 cells))
      (function largest (buffer 0))
      (function window (returns-record ((cells) (borrow 0 cells)))))
