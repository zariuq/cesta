(unit
  (var int (function printf ((const char) (* format)) ...))
  (var void (* (function malloc ((unsigned long) size))))
  (var void (function free (void (* pointer))))
  (typedef (struct Node (int value) ((struct Node) (* next))) Node)
  (fn int main (void)
    (var Node (* head) (call malloc (sizeof type Node)))
    (var Node (* tail) (call malloc (sizeof type Node)))
    (if (|| (== head 0) (== tail 0)) (block (call free head) (call free tail) (return 1)))
    (= (-> head value) 3)
    (= (-> head next) tail)
    (= (-> tail value) 4)
    (= (-> tail next) 0)
    (var int total 0)
    (for (var Node (* p) head) p (= p (-> p next)) (+= total (-> p value)))
    (call printf "%d\n" total)
    (call free tail)
    (call free head)
    (return (!= total 7))))
